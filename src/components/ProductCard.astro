---
import { type Product, money } from '../data/products';
import ProductImage from './ProductImage.astro';
import Icon from './Icon.astro';
interface Props { product: Product; }
const { product } = Astro.props;
---
<article class="product-card">
  <div class="product-card__visual">
    <a class="product-card__image" href={`/shop/${product.slug}`} aria-label={`Meet ${product.name}`}>
      <ProductImage product={product} sizes="(max-width: 760px) 50vw, 33vw" />
      <ProductImage product={product} view={product.scene} alt="" class="product-card__hover" sizes="(max-width: 760px) 50vw, 33vw" />
    </a>
    <button class="quick-add" data-add={product.slug} aria-label={`Add ${product.name} to bag`}><Icon name="plus" /></button>
  </div>
  <div class="product-card__copy">
    <div class="product-card__title"><h3><a href={`/shop/${product.slug}`}>{product.name}</a></h3><span class="price">{money(product.price)}</span></div>
    <p class="product-card__mood">{product.mood.replace(/^For /, 'for ')}</p>
  </div>
</article>
