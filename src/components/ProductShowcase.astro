if (paused || !visible || focused || document.hidden---
import ProductImage from './ProductImage.astro';
import Icon from './Icon.astro';
import { products, money } from '../data/products';
const featured = [...products.filter(product => product !== products[2]), products[2]];
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="gubbi-feature" aria-labelledby="spotlight-title" aria-roledescription="carousel" data-showcase>
 <div class="wrap">
  <header class="gubbi-feature-heading">
   <h2 id="spotlight-title">Full Bengaluru.<br/><em>Swalpa shelf space.</em></h2>
   <div class="showcase-toolbar" hidden>
    <span class="showcase-count"><span data-current>01</span><span aria-hidden="true">/</span>{pad(featured.length)}</span>
    <button type="button" data-prev aria-label="Previous product"><span class="back-arrow"><Icon/></span></button>
    <button type="button" data-next aria-label="Next product"><Icon/></button>
   </div>
  </header>
  <div class="showcase-stage">
   {featured.map((product, index) => <div class="gubbi-feature-layout showcase-slide" data-slide aria-roledescription="slide" role="group" aria-label={`${index + 1} of ${featured.length}: ${product.name}`} aria-hidden={index !== 0 ? 'true' : undefined} inert={index !== 0}>
    <figure class="gubbi-feature-print"><ProductImage product={product} sizes="(max-width: 760px) 92vw, 640px" eager={index === 0}/><figcaption>{product.mood}</figcaption></figure>
    <div class="gubbi-feature-ticket">
     <p class="gubbi-feature-kicker">{pad(index + 1)} · In the limelight</p>
     <h3>{product.name}</h3>
     <p class="gubbi-feature-quote">“{product.short}”</p>
     <p>{product.story}</p>
     <div class="gubbi-feature-actions"><button class="button" type="button" data-add={product.slug}>Add to bag <span class="gubbi-feature-price">{money(product.price)}</span></button><a class="text-link" href={`/shop/${product.slug}`}>Meet {product.name} <Icon/></a></div>
     <p class="gubbi-feature-note">Hand-turned in Channapatna. Ships across India.</p>
    </div>
   </div>)}
  </div>
  <div class="showcase-picker" aria-label="Choose a featured product" hidden>
   {featured.map((product, index) => <button type="button" data-select={index} aria-label={`Show ${product.name}`} aria-pressed={index === 0}><span class="showcase-progress" aria-hidden="true"></span><span class="showcase-index">{pad(index + 1)}</span><span>{product.name}</span></button>)}
  </div>
  <p class="sr-only" data-announcement aria-live="polite" aria-atomic="true"></p>
 </div>
</section>

<style>
 [hidden] { display: none; }
 .showcase-toolbar { display: flex; align-items: center; gap: 8px; }
 .showcase-count { display: inline-flex; gap: 6px; margin-right: 12px; font-variant-numeric: tabular-nums; font-size: 13px; color: var(--blue-pale); }
 .showcase-count [data-current] { color: var(--paper); }
 .showcase-toolbar button { display: grid; place-items: center; min-width: 46px; min-height: 46px; border: 1px solid var(--line-on-dark); border-radius: 50%; background: transparent; color: var(--paper); cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast); }
 .showcase-toolbar button:hover { background: var(--paper); color: var(--blue); }
 .back-arrow { display: flex; rotate: 180deg; }
 .showcase-stage { display: grid; }
 .showcase-slide { grid-area: 1 / 1; min-width: 0; opacity: 1; transition: opacity 350ms ease, transform 450ms cubic-bezier(.16,1,.3,1); }
 .showcase-slide[aria-hidden="true"] { visibility: hidden; opacity: 0; transform: translateX(24px); pointer-events: none; }
 .showcase-picker { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0 20px; margin-top: 44px; border-top: 1px solid var(--line-on-dark-soft); }
 .showcase-picker button { position: relative; display: flex; align-items: baseline; gap: 10px; padding: 14px 0 0; border: 0; background: transparent; color: var(--blue-pale); text-align: left; font: 500 12px/1.4 var(--font-body); cursor: pointer; transition: color var(--dur-fast); }
 .showcase-picker button:hover { color: var(--paper); }
 .showcase-picker button[aria-pressed="true"] { color: var(--paper); }
 .showcase-index { font-variant-numeric: tabular-nums; opacity: .6; }
 .showcase-progress { position: absolute; top: -1px; left: 0; width: 100%; height: 2px; background: var(--yellow); transform: scaleX(0); transform-origin: left; }
 [aria-pressed="true"] .showcase-progress { transform: scaleX(1); }
 [data-running="true"] .showcase-picker [aria-pressed="true"] .showcase-progress { transform: scaleX(0); animation: showcase-timer 6s linear forwards; }
 .gubbi-feature button:focus-visible, .gubbi-feature a:focus-visible { outline: 3px solid var(--yellow); outline-offset: 5px; }
 @keyframes showcase-timer { to { transform: scaleX(1); } }
 @media (max-width: 760px) {
  .showcase-picker { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; margin-top: 32px; }
  .showcase-picker button { min-height: 52px; padding-top: 10px; }
  .showcase-picker button > span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 }
 @media (prefers-reduced-motion: reduce) { .showcase-slide { transition: none; transform: none; } [data-running="true"] .showcase-picker [aria-pressed="true"] .showcase-progress { animation: none; transform: scaleX(1); } }
</style>

<script>
const showcase = document.querySelector<HTMLElement>('[data-showcase]');
if (showcase) {
 const slides = [...showcase.querySelectorAll<HTMLElement>('[data-slide]')];
 const selectors = [...showcase.querySelectorAll<HTMLButtonElement>('[data-select]')];
 const motion = matchMedia('(prefers-reduced-motion: reduce)');
 let current = 0;
 let paused = motion.matches;
 let focused = false;
 let visible = false;
 let timer: ReturnType<typeof setTimeout>;
 showcase.querySelectorAll<HTMLElement>('[hidden]').forEach(element => element.hidden = false);
 function schedule() {
  clearTimeout(timer);
  showcase!.dataset.running = 'false';
  if (paused || !visible || focused || document.hidden || document.querySelector('dialog[open]')) return;
  // Restart the six-second indicator together with the next slide's timer.
  void showcase!.offsetWidth;
  showcase!.dataset.running = 'true';
  timer = setTimeout(() => { show(current + 1); }, 6000);
 }
 function show(index: number, manual = false) {
  current = (index + slides.length) % slides.length;
  slides.forEach((slide, i) => {
   slide.inert = i !== current;
   slide.setAttribute('aria-hidden', String(i !== current));
   selectors[i].setAttribute('aria-pressed', String(i === current));
  });
  showcase!.querySelector('[data-current]')!.textContent = String(current + 1).padStart(2, '0');
  if (manual) {
   showcase!.querySelector('[data-announcement]')!.textContent = slides[current].getAttribute('aria-label');
  }
  schedule();
 }
 selectors.forEach((button, index) => button.addEventListener('click', () => show(index, true)));
 showcase.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1, true));
 showcase.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1, true));
 // Keyboard users get a still carousel while they are inside it; it resumes when focus leaves.
 showcase.addEventListener('focusin', event => { focused = (event.target as Element).matches(':focus-visible'); schedule(); });
 showcase.addEventListener('focusout', event => { if (!showcase!.contains(event.relatedTarget as Node)) { focused = false; schedule(); } });
 document.addEventListener('visibilitychange', schedule);
 motion.addEventListener('change', () => { paused = motion.matches; schedule(); });
 new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; schedule(); }, { threshold: .25 }).observe(showcase);
 schedule();
}
</script>
