---
import Icon from './Icon.astro';
import Flower from './Flower.astro';
const path = Astro.url.pathname;
const current = (test: boolean) => (test ? 'page' : undefined);
---
<a class="announcement" href="/shop">Bengaluru memes. Now in wood. <span>Meet the gang</span><Icon/></a>
<header class="site-header wrap">
  <nav class="desktop-nav desktop-nav--left" aria-label="Main navigation"><a href="/shop" aria-current={current(path.includes('/shop') || path.includes('/gang/'))}>Shop the gang</a><a href="/philosophy" aria-current={current(path === '/philosophy')}>The craft</a></nav>
  <a class="brand" href="/" aria-label="Gubbi gang home"><Flower class="brand-flower"/><span>gubbi<span class="brand-small">GANG</span></span></a>
  <div class="header-actions"><nav class="desktop-nav desktop-nav--right" aria-label="More navigation"><a href="/story" aria-current={current(path === '/story')}>Our story</a><a href="/faq" aria-current={current(path === '/faq')}>Doubts?</a></nav><button class="button bag-button" data-open-bag><Icon name="bag"/>Bag <span data-bag-count>0</span></button><button class="icon-button menu-button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open navigation" data-menu><Icon name="menu"/></button></div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden><a href="/shop">Shop the gang</a><a href="/philosophy">The craft</a><a href="/story">Our story</a><a href="/faq">Doubts?</a><a href="https://gubbiartclub.com">Gubbi Art Club ↗</a></nav>
</header>
