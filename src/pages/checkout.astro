---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const inr = (value: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(value);
const states = ['Andhra Pradesh','Arunachal Pradesh','Assam','Bihar','Chhattisgarh','Goa','Gujarat','Haryana','Himachal Pradesh','Jharkhand','Karnataka','Kerala','Madhya Pradesh','Maharashtra','Manipur','Meghalaya','Mizoram','Nagaland','Odisha','Punjab','Rajasthan','Sikkim','Tamil Nadu','Telangana','Tripura','Uttar Pradesh','Uttarakhand','West Bengal','Andaman and Nicobar Islands','Chandigarh','Dadra and Nagar Haveli and Daman and Diu','Delhi','Jammu and Kashmir','Ladakh','Lakshadweep','Puducherry'];
---
<Layout title="Checkout — The Gubbi" noindex><header class="checkout-heading wrap"><a href="/shop" class="text-link">← Back to the shop</a><h1>Almost yours.<br/><span class="serif">Don’t blink.</span></h1><p>Ships from Bengaluru in {site.dispatchDays}. Faster than any “reaching in five minutes”. Free shipping over {inr(site.freeShippingOver)}.</p></header><section class="checkout-layout wrap" id="checkout-content"><form id="checkout-form" novalidate><h2>Where does it live now?</h2><div class="form-grid"><label>First name<input name="firstName" autocomplete="given-name" required maxlength="80"/></label><label>Last name<input name="lastName" autocomplete="family-name" required maxlength="80"/></label><label class="full-width">Email<input name="email" type="email" autocomplete="email" required maxlength="160"/></label><label class="full-width">Phone<input name="phone" type="tel" autocomplete="tel" inputmode="numeric" pattern="[6-9][0-9]{9}" title="Enter a ten-digit Indian mobile number" required maxlength="10"/></label><label class="full-width">Address<input name="address" autocomplete="address-line1" required maxlength="250" placeholder="Flat, building, street"/></label><label class="full-width">Landmark <span class="muted">(optional)</span><input name="landmark" autocomplete="address-line2" maxlength="120" placeholder="Opposite the bakery, near the big tree"/></label><label>City<input name="city" autocomplete="address-level2" required maxlength="80"/></label><label>State<select name="state" autocomplete="address-level1" required><option value="">Choose</option>{states.map(state => <option value={state} selected={state === 'Karnataka'}>{state}</option>)}</select></label><label>PIN code<input name="postalCode" autocomplete="postal-code" inputmode="numeric" pattern="[1-9][0-9]{5}" title="Enter a six-digit Indian PIN code" required maxlength="6"/></label></div><label class="gift-checkbox"><input type="checkbox" id="gift-toggle"/>It’s a gift. We handwrite your note and hide the price, like a good friend.</label><label id="gift-note-field" hidden>Your note<textarea name="giftNote" maxlength="300" rows="3" placeholder="Saw this. Thought of you. You owe me one." disabled></textarea></label><p class="form-error small" id="checkout-error" role="alert" hidden></p><button class="button button--wide" type="submit">Pay and make it official <Icon/></button><p class="small muted">UPI, cards and net banking. Secured by our payment partner; we never see your card details. By continuing you agree to the <a href="/terms">terms</a> and <a href="/privacy">privacy policy</a>.</p></form><aside class="checkout-summary"><h2>The damage</h2><div id="checkout-items"></div><div class="summary-line"><span>Subtotal</span><span data-checkout-subtotal></span></div><div class="summary-line"><span>Shipping</span><span data-checkout-shipping></span></div><div class="subtotal"><span>Total</span><strong data-checkout-total></strong></div><p class="small muted">Prices include GST. {site.returnDays}-day returns on unused pieces. <a href="/shipping-and-returns">Shipping &amp; returns</a>.</p><button class="text-button" data-open-bag>Second thoughts? Edit bag</button></aside></section><section class="checkout-empty wrap" id="checkout-empty" hidden><h2>Checkout with an empty bag? Bold.</h2><p>Nothing in here yet. Your desk is watching.</p><a class="button" href="/shop">Go pick someone <Icon/></a></section><section class="checkout-success wrap" id="checkout-success" hidden tabindex="-1"><img src="/brand/gubbi-flower.svg" alt="" width="90" height="90"/><h2>Order in. <span class="serif">Absolute legend.</span></h2><p>Confirmation is heading to your inbox. Your order leaves Bengaluru in {site.dispatchDays}, and we send tracking the moment it does. Actually the moment. Not “bartha idini”.</p><a class="button" href="/shop">One more? One more. <Icon/></a></section></Layout>
