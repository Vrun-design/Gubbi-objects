---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductCrop from '../components/ProductCrop.astro';
import Flower from '../components/Flower.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products';
import { questions } from '../data/quiz';
import fs from 'node:fs';

const phrases = ['SWALPA ADJUST MAADI', 'ONE TEA BEKU', 'SILK BOARD IS A STATE OF MIND', 'METER HAAKI BOSS', 'OLD CRAFT. NEW MISCHIEF.', 'SIKKAPATTE CHENNAGIDE'];

const craftSteps = [
  { n: '01', name: 'Turn', line: 'Wood on a lathe. Shaped by hand, judged by eye.' },
  { n: '02', name: 'Lac', line: 'Colour pressed on while it is still spinning.' },
  { n: '03', name: 'Polish', line: 'The shine comes from friction. Not from a spray can.' },
  { n: '04', name: 'Guy', line: 'He gets a name, a job, and one specific problem.' },
];

const chat = [
  { who: 'Traffic Kumar', tone: 'c-1', text: 'reaching in 10 min' },
  { who: 'Silk Board Forever Loop', tone: 'c-2', text: 'he said that at 6' },
  { who: 'Namma Metro Sprint', tone: 'c-3', text: 'I’m already there. doors closed on my bag though' },
  { who: 'Copilot Confusion', tone: 'c-4', text: 'I can fix his route. 97% confident' },
  { who: 'Silk Board Forever Loop', tone: 'c-2', text: 'last time you were 97% confident we ended up in Hosur' },
  { who: 'Workflow Spinner 2AM', tone: 'c-5', text: 'prod is down. nobody come.' },
  { who: 'Traffic Kumar', tone: 'c-1', text: 'reaching in 10 min' },
];

const firstQuestion = questions[0];
// Words that complete “make room for the ___”. The first one is the name.
const rotating = ['gang.', 'desk.', 'bestie.', 'chaos.', 'drama.', 'city.'];
// Drop a hero image at public/hero-bg.jpg and it is picked up at build time.
const heroImage = ['hero-bg.jpg', 'hero-bg.png', 'hero-bg.webp'].map(name => `/${name}`).find(name => fs.existsSync(`public${name}`));
---
<Layout>
<section class="hero-center">
 {heroImage && <img class="hero-center-bg" src={heroImage} alt="" width="2400" height="1600" fetchpriority="high"/>}
 <div class="wrap hero-center-inner">
  <p class="hero-center-meta">Bengaluru · Wooden collectibles · Channapatna craft</p>
  <h1><span class="hero-center-serif">Swalpa</span> adjust<br/>maadi for the <span class="hero-center-word" data-rotate>{rotating[0]}</span></h1>
  <p class="hero-center-lede">Wooden collectibles that are basically Bengaluru memes — the traffic, the scroll, the 2am deploy.</p>
  <a class="button" href="#gang">Meet the gang <Icon/></a>
  <div class="club-hero-note"><Flower/><span>Company for your desk. Gifts for your bestie.</span></div>
 </div>
</section>

<div class="club-marquee"><div class="club-ticker" aria-label={phrases.join('. ')}><div class="club-marquee-track" aria-hidden="true">{[0,1].map(()=><div class="club-marquee-group">{phrases.map(phrase=><><span>{phrase}</span><Flower/></>)}</div>)}</div></div></div>

<section class="club-section wrap" id="gang">
 <header class="section-head"><div><h2>Meet the <em>gang.</em></h2><p>Six personalities. One deeply relatable city. All of them unemployed.</p></div><a class="text-link" href="/shop">Sort, filter, spiral <Icon/></a></header>
 <p class="preview-note">The first collection · concept images and illustrative prices</p>
 <div class="product-grid">{products.map(product=><ProductCard product={product}/>)}</div>
 <div class="club-section-foot"><span>Choosing a favourite is a very personal attack.</span><a class="text-link" href="#which">Fine, you choose for me <Icon/></a></div>
</section>

<section class="club-quiz" id="which">
 <div class="wrap">
  <header class="section-head"><div><h2>Which one are <em>you?</em></h2><p>Three questions. One uncomfortably accurate result.</p></div></header>
  <div class="club-quiz-card">
   <div class="club-quiz-ask" data-quiz-ask>
    <p class="club-quiz-step"><span data-quiz-step>1</span> / {questions.length}</p>
    <p class="club-quiz-prompt" data-quiz-prompt>{firstQuestion.prompt}</p>
    <div class="club-quiz-options" data-quiz-options>{firstQuestion.answers.map((answer, index)=><button type="button" data-quiz-pick={index}>{answer.label}</button>)}</div>
   </div>
   <div class="club-quiz-result" data-quiz-result hidden aria-live="polite">
    <div class="club-quiz-photo"><ProductCrop position="p-1" alt=""/></div>
    <div class="club-quiz-verdict">
     <h3 data-quiz-name>Traffic Kumar</h3>
     <p class="club-quiz-line" data-quiz-verdict></p>
     <p class="club-quiz-aside">yeah. it’s you.</p>
     <p class="club-quiz-price"><strong data-quiz-price></strong> <span>illustrative price</span></p>
     <div class="club-quiz-actions"><button class="button" type="button" data-quiz-add>Add to bag <Icon name="bag"/></button><a class="text-link" data-quiz-link href="/gang/traffic-kumar">Read his whole deal <Icon/></a></div>
     <button class="text-button" type="button" data-quiz-reset>Wrong. Ask me again.</button>
    </div>
   </div>
  </div>
  <p class="club-quiz-escape"><a class="text-link" href="/shop">Skip the therapy, show me all six <Icon/></a></p>
 </div>
</section>

<section class="club-craft">
 <div class="wrap club-craft-inner">
  <div class="club-craft-copy">
   <h2>Old craft.<br/><em>New mischief.</em></h2>
   <p>Channapatna, two hours down the road, is called Gombegala Ooru — the town of dolls. Wooden gombe have been turned on a lathe and coloured with lacquer there for generations.</p>
   <p>We’re making little guys in that spirit, about the city we’re actually in. The craft is old. The problems are extremely 2026.</p>
   <a class="text-link" href="/philosophy">The whole craft story <Icon/></a>
   <div class="club-signature">with love, and swalpa local chaos.</div>
  </div>
  <div class="club-craft-art" aria-hidden="true"><Flower/><span>Gombegala<br/>Ooru</span></div>
 </div>
 <div class="wrap">
  <ol class="club-craft-steps">
   {craftSteps.map(step=><li><span class="club-craft-n">{step.n}</span><h3>{step.name}</h3><p>{step.line}</p></li>)}
  </ol>
  <p class="club-craft-note">We’re still in prototypes. Makers, materials and final specifications get named when the first batch is approved — not before.</p>
 </div>
</section>

<section class="club-section wrap club-size">
 <header class="section-head"><div><h2>Eshtu <em>doddadu?</em></h2><p>How big, actually? Palm-size. Small enough to be a gift, big enough to have opinions.</p></div></header>
 <div class="club-size-inner">
  <div class="club-size-frame">
   <span class="club-size-dim club-size-dim--v" aria-hidden="true"></span>
   <div class="club-size-print"><ProductCrop position="p-2" alt="Doomscroll Buddy object concept, shown for scale"/></div>
   <span class="club-size-dim club-size-dim--h" aria-hidden="true"></span>
   <span class="club-size-tag">palm-size</span>
  </div>
  <ul class="club-size-list">
   <li>Smaller than your water bottle.</li>
   <li>Bigger than your attention span.</li>
   <li>Fits on a monitor stand.</li>
   <li>Fits in a gift bag.</li>
   <li>Does not fit in your carry-on guilt.</li>
  </ul>
 </div>
 <p class="preview-note">Target scale only. Exact dimensions are confirmed with the first approved batch.</p>
</section>

<section class="club-chat">
 <div class="wrap">
  <header class="section-head"><div><h2>Inside the <em>group chat.</em></h2><p>The gang has one. It is not productive.</p></div></header>
  <div class="club-chat-inner">
   <div class="club-chat-panel">
    <div class="club-chat-head"><span class="club-chat-title">gubbi gang</span><span class="club-chat-meta">6 members · 4 typing</span></div>
    <ol class="club-chat-log">
     {chat.map(message=><li class={`club-chat-msg ${message.tone}`}><span class="club-chat-who">{message.who}</span><p>{message.text}</p></li>)}
     <li class="club-chat-msg club-chat-msg--typing"><span class="club-chat-who">Doomscroll Buddy</span><p><span class="club-chat-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>typing… (has been for two hours)</span></p></li>
    </ol>
   </div>
   <div class="club-chat-aside">
    <p class="club-chat-pull">Nobody in this chat has ever arrived on time.</p>
    <p class="club-chat-note">Written by us, obviously. They are made of wood and have no phones.</p>
    <a class="text-link" href="#gang">Meet them properly <Icon/></a>
   </div>
  </div>
 </div>
</section>

<section class="club-section wrap">
 <header class="section-head"><div><h2>Gifting? <em>Say less.</em></h2><p>Good gifts say “I know you.” Great gifts say “this is literally you,” and it is a little rude.</p></div></header>
 <div class="club-gift-grid">
  <a class="club-gift club-gift--work" href="/shop?category=Tech+worker"><div><h3>For the work bestie.<br/>And their 47 tabs.</h3><p>Office damage, beautifully wrapped. Not another mug.</p><span class="button">Find their desk mate <Icon/></span></div><div class="club-gift-photo"><ProductCrop position="p-5" alt="Copilot Confusion engineer and robot concept"/></div></a>
  <a class="club-gift club-gift--city" href="/shop?category=Bengaluru"><div><h3>For the one who is<br/>very Bengaluru.</h3><p>Even their complaints about this city sound like love.</p><span class="button">Wrap up a little city <Icon/></span></div><div class="club-gift-photo"><ProductCrop position="p-6" alt="Namma Metro Sprint object concept"/></div></a>
 </div>
</section>

<section class="club-section wrap club-other-world">
 <div><h2>Rather make things<br/><em>with your own hands?</em></h2><p>Same gubbi, different kind of time-pass. Paint, crochet and make a beautiful little mess at Gubbi Art Club.</p><a class="text-link" href="https://gubbiartclub.com">Come over to the Art Club <Icon/></a></div>
 <a href="https://gubbiartclub.com" class="club-invitation"><Flower/><h3>Less screen.<br/>More mess.</h3><span>Find your workshop <Icon/></span></a>
</section>

<section class="club-section wrap club-faq">
 <h2>A few <em>doubts.</em></h2>
 <div>
  <details><summary>Boss, can I actually buy these?<Icon name="plus"/></summary><p>Not yet. This is a collection preview. Look around, build a bag, poke at checkout — but no order is placed and no payment is taken. The prices are illustrative.</p></details>
  <details><summary>Toys, or grown-up things?<Icon name="plus"/></summary><p>Grown-up things. These are collectible objects for adult desks and shelves, in the spirit of Channapatna gombe. Final specifications get shared with the first approved batch.</p></details>
  <details><summary>Innu jaasti bartha? More coming?<Icon name="plus"/></summary><p>That’s the plan. These six are the starting concepts. More local stories and uncomfortably familiar personalities follow as we work through prototypes.</p></details>
  <a class="text-link" href="/faq">A few more answers <Icon/></a>
 </div>
</section>
</Layout>

<script>
import { products, money } from '../data/products';
import { questions, verdicts } from '../data/quiz';

const ask = document.querySelector<HTMLElement>('[data-quiz-ask]');
const result = document.querySelector<HTMLElement>('[data-quiz-result]');

if (ask && result) {
  const stepLabel = ask.querySelector<HTMLElement>('[data-quiz-step]')!;
  const prompt = ask.querySelector<HTMLElement>('[data-quiz-prompt]')!;
  const options = ask.querySelector<HTMLElement>('[data-quiz-options]')!;
  const crop = result.querySelector<HTMLElement>('.product-crop')!;
  const image = crop.querySelector('img')!;
  const addButton = result.querySelector<HTMLButtonElement>('[data-quiz-add]')!;

  let step = 0;
  let picks: string[] = [];

  const render = () => {
    const question = questions[step];
    stepLabel.textContent = String(step + 1);
    prompt.textContent = question.prompt;
    options.innerHTML = question.answers
      .map((answer, index) => `<button type="button" data-quiz-pick="${index}">${answer.label}</button>`)
      .join('');
  };

  const winner = () => {
    const tally = new Map<string, number>();
    picks.forEach(slug => tally.set(slug, (tally.get(slug) ?? 0) + 1));
    // Ties break toward the earliest pick, so iterate the picks, not the map.
    return picks.reduce((best, slug) => (tally.get(slug)! > tally.get(best)! ? slug : best), picks[0]);
  };

  const reveal = () => {
    const product = products.find(item => item.slug === winner())!;
    crop.className = `product-crop ${product.position}`;
    image.alt = `${product.name} object concept`;
    result.querySelector('[data-quiz-name]')!.textContent = product.name;
    result.querySelector('[data-quiz-verdict]')!.textContent = verdicts[product.slug];
    result.querySelector('[data-quiz-price]')!.textContent = money(product.price);
    result.querySelector('[data-quiz-link]')!.setAttribute('href', `/gang/${product.slug}`);
    addButton.dataset.add = product.slug;
    ask.hidden = true;
    result.hidden = false;
  };

  options.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-quiz-pick]');
    if (!button) return;
    picks.push(questions[step].answers[Number(button.dataset.quizPick)].slug);
    step += 1;
    if (step < questions.length) render();
    else reveal();
  });

  result.querySelector('[data-quiz-reset]')!.addEventListener('click', () => {
    step = 0;
    picks = [];
    render();
    result.hidden = true;
    ask.hidden = false;
    options.querySelector('button')?.focus();
  });
}

const word = document.querySelector<HTMLElement>('[data-rotate]');
if (word && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const words = ['gang.', 'desk.', 'bestie.', 'chaos.', 'drama.', 'city.'];
  let at = 0;
  setInterval(() => {
    word.classList.add('is-leaving');
    setTimeout(() => {
      at = (at + 1) % words.length;
      word.textContent = words[at];
      word.classList.remove('is-leaving');
    }, 320);
  }, 2800);
}
</script>
