---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductCrop from '../components/ProductCrop.astro';
import Flower from '../components/Flower.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products';
import fs from 'node:fs';

const phrases = ['SWALPA ADJUST MAADI', 'ONE TEA BEKU', 'SILK BOARD IS A STATE OF MIND', 'METER HAAKI BOSS', 'OLD CRAFT. NEW MISCHIEF.', 'SIKKAPATTE CHENNAGIDE'];

const facts = [
  { title: 'Lathe-turned, lac-coloured.', line: 'The Channapatna way: colour pressed on while the wood is still spinning. No paint, no brush, no spray can.' },
  { title: 'Palm-size.', line: 'Smaller than your water bottle. Sits on a monitor stand without fighting the second screen.' },
  { title: 'One guy, one problem.', line: 'Each object is a person with a name, a job and a situation he is not getting out of. Very good company while you don’t either.' },
];

const doubts = [
  ['Boss, can I actually buy these?', 'Not yet. This is a collection preview. Look around, build a bag, poke at checkout — but no order is placed and no payment is taken.'],
  ['Are the prices final?', 'No. Every price here is illustrative, so you can try the shopping flow. Approved prices and any charges get published before orders open.'],
  ['Will he look exactly like the picture?', 'The pictures are the concept sheet. Prototypes and production will shape the final form, materials and finish. Real photography and specs come before launch.'],
  ['Toys, or grown-up things?', 'Grown-up things. Collectible objects for adult desks and shelves, in the spirit of Channapatna gombe. Not offered as children’s toys.'],
  ['Who is making them?', 'Our intended starting point is Channapatna’s craft community. Production partners, maker names and materials are not confirmed yet — they get named when the first batch is approved, not before.'],
  ['Shipping? Returns? Delivery eshtu days?', 'Regions, timelines, costs and return terms get confirmed before the first collection goes on sale. No shipping promise applies to this preview.'],
  ['Can I gift one?', 'That is very much the idea. For now you can add a gift note at preview checkout and see how it feels. Nothing is sent.'],
  ['Does the site save my information?', 'Only your preview bag, and only in this browser. Checkout details and gift notes are not submitted or stored. No account, no mailing list.'],
  ['Innu jaasti bartha? More coming?', 'That’s the plan. These six are the starting concepts. More local stories and uncomfortably familiar personalities follow as we work through prototypes.'],
];

const spotlight = products.find(product => product.slug === 'silk-board-forever-loop')!;

// Words that complete “make room for the ___”. The first one is the name.
const rotating = ['gang.', 'desk.', 'bestie.', 'chaos.', 'drama.', 'city.'];
// Drop a hero image at public/hero-bg.jpg and it is picked up at build time.
const heroImage = ['hero-bg.jpg', 'hero-bg.png', 'hero-bg.webp'].map(name => `/${name}`).find(name => fs.existsSync(`public${name}`));
---
<Layout>
<section class="hero-center">
 {heroImage && <img class="hero-center-bg" src={heroImage} alt="" width="2400" height="1600" fetchpriority="high"/>}
 <div class="wrap hero-center-inner">
  <p class="hero-center-meta">Bengaluru · Wooden collectibles · Channapatna craft</p>
  <h1><span class="hero-center-serif">Swalpa</span> adjust<br/>maadi for the <span class="hero-center-word" data-rotate>{rotating[0]}</span></h1>
  <p class="hero-center-lede">Wooden collectibles that are basically Bengaluru memes — the traffic, the scroll, the 2am deploy.</p>
  <a class="button" href="#gang">Meet the gang <Icon/></a>
  <div class="club-hero-note"><Flower/><span>Company for your desk. Gifts for your bestie.</span></div>
 </div>
</section>

<div class="club-marquee"><div class="club-ticker" aria-label={phrases.join('. ')}><div class="club-marquee-track" aria-hidden="true">{[0,1].map(()=><div class="club-marquee-group">{phrases.map(phrase=><><span>{phrase}</span><Flower/></>)}</div>)}</div></div></div>

<section class="club-section wrap" id="gang">
 <header class="section-head"><div><h2>Meet the <em>gang.</em></h2><p>Six personalities. One deeply relatable city. All of them unemployed.</p></div><a class="text-link" href="/shop">Sort, filter, spiral <Icon/></a></header>
 <div class="product-grid">{products.map(product=><ProductCard product={product}/>)}</div>
</section>

<section class="club-spotlight" aria-labelledby="spotlight-title">
 <div class="wrap club-spotlight-inner">
  <div class="club-spotlight-photo"><ProductCrop position={spotlight.position} alt={`${spotlight.name} object concept`}/><span class="club-spotlight-stamp"><Flower/><span>Turn<br/>me</span></span></div>
  <div class="club-spotlight-copy">
   <h2 id="spotlight-title">{spotlight.name}</h2>
   <p class="club-spotlight-meta">Object {spotlight.number} · {spotlight.tags.join(' · ')} · {spotlight.colour}</p>
   <p class="club-spotlight-short">{spotlight.short}</p>
   <p class="club-spotlight-story">{spotlight.story}</p>
   <p class="club-spotlight-price"><strong>₹{spotlight.price.toLocaleString('en-IN')}</strong><span>illustrative price</span></p>
   <div class="club-spotlight-actions"><button class="button" type="button" data-add={spotlight.slug}>Add to bag <Icon name="bag"/></button><a class="text-link" href={`/gang/${spotlight.slug}`}>Read his whole deal <Icon/></a></div>
  </div>
 </div>
</section>

<section class="club-deal" aria-labelledby="deal-title">
 <div class="wrap club-deal-inner">
  <div class="club-deal-copy">
   <h2 id="deal-title">Gombe alla, boss.<br/><em>Idu gang.</em></h2>
   <p class="club-deal-lede">Not toys. Wooden collectibles, turned and lacquered the Channapatna way, about the Bengaluru you actually live in.</p>
   <a class="text-link" href="/philosophy">The whole craft story <Icon/></a>
  </div>
  <div>
   <ul class="club-deal-facts">{facts.map(fact=><li><h3>{fact.title}</h3><p>{fact.line}</p></li>)}</ul>
   <p class="club-deal-note">Still in prototypes. Makers, materials and final specifications get named with the first approved batch — not before.</p>
  </div>
 </div>
</section>

<section class="club-vote">
 <div class="wrap club-vote-inner">
  <div class="club-vote-copy">
   <h2>Who should we<br/>make <em>first?</em></h2>
   <p>First batch, first dibs. Six concepts, one run. Pick your guy — loudly, if you like.</p>
   <p class="club-vote-note" data-vote-note>Counted on this device for now. Real voting comes with the real batch.</p>
  </div>
  <div class="club-vote-grid" data-vote>
   {products.map(product=><button type="button" data-vote-pick={product.slug} aria-pressed="false"><span class="club-vote-n">{product.number}</span><span class="club-vote-name">{product.name}</span><span class="club-vote-mood">{product.mood}</span></button>)}
  </div>
 </div>
</section>

<section class="club-section wrap club-other-world">
 <div><h2>Rather make things<br/><em>with your own hands?</em></h2><p>Same gubbi, different kind of time-pass. Paint, crochet and make a beautiful little mess at Gubbi Art Club.</p><a class="text-link" href="https://gubbiartclub.com">Come over to the Art Club <Icon/></a></div>
 <a href="https://gubbiartclub.com" class="club-invitation"><Flower/><h3>Less screen.<br/>More mess.</h3><span>Find your workshop <Icon/></span></a>
</section>

<section class="club-section wrap club-faq" id="doubts" aria-labelledby="doubts-title">
 <div class="club-faq-head"><h2 id="doubts-title">A few <em>doubts.</em></h2><p>No small-print energy. Here is where things stand.</p></div>
 <div class="club-faq-list">{doubts.map(([question, answer])=><details><summary>{question}<Icon name="plus"/></summary><p>{answer}</p></details>)}</div>
</section>
</Layout>

<script>
import { products } from '../data/products';
const vote = document.querySelector<HTMLElement>('[data-vote]');
if (vote) {
  const note = document.querySelector<HTMLElement>('[data-vote-note]')!;
  const key = 'gubbi-vote';
  const paint = (slug: string | null) => {
    vote.querySelectorAll<HTMLButtonElement>('[data-vote-pick]').forEach(button => {
      button.setAttribute('aria-pressed', String(button.dataset.votePick === slug));
    });
    if (slug) {
      const name = products.find(item => item.slug === slug)?.name ?? slug;
      note.textContent = `Noted. ${name} gets your vote. Tap another to change your mind, it’s allowed.`;
    }
  };
  let saved: string | null = null;
  try { saved = localStorage.getItem(key); } catch {}
  paint(saved);
  vote.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-vote-pick]');
    if (!button) return;
    const slug = button.dataset.votePick!;
    try { localStorage.setItem(key, slug); } catch {}
    paint(slug);
  });
}

const word = document.querySelector<HTMLElement>('[data-rotate]');
if (word && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const words = ['gang.', 'desk.', 'bestie.', 'chaos.', 'drama.', 'city.'];
  let at = 0;
  setInterval(() => {
    word.classList.add('is-leaving');
    setTimeout(() => {
      at = (at + 1) % words.length;
      word.textContent = words[at];
      word.classList.remove('is-leaving');
    }, 320);
  }, 2800);
}
</script>
