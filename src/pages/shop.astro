---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products';
const categories = ['All objects', 'Bengaluru', 'Tech worker', 'Internet brain'];
---
<Layout title="Shop objects — The Gubbi">
<header class="shop-hero wrap"><div><h1>Find your<br/><span class="serif">kind of weird.</span></h1><p>Small objects. Suspiciously familiar personalities.<br/>Made for desks, shelves, and people with a story.</p></div><div class="shop-stamp"><img src="/brand/gubbi-flower.svg" alt="" width="65" height="65"/><span>LOCALLY INSPIRED.<br/>PERSONALLY ATTACKED.</span></div></header>
<section class="shop-section wrap" aria-label="Object collection"><div class="shop-tools"><div class="filters" aria-label="Filter collection">{categories.map((category, index) => <button class:list={['filter', index === 0 && 'is-active']} data-filter={index === 0 ? 'all' : category} aria-pressed={index === 0}>{category}</button>)}</div><label class="search-field" id="search"><Icon name="search"/><input type="search" id="product-search" placeholder="Find your desk mate" aria-label="Search objects"/></label></div><div class="collection-meta"><span id="result-count" role="status" aria-live="polite">6 objects. Plenty of character.</span><label class="sort-label">Sort by <select id="product-sort" aria-label="Sort objects"><option value="collection">Collection order</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option><option value="name">Name: A–Z</option></select></label></div><p class="preview-note">Collection preview. Images are concepts; prices are illustrative. No orders or payments.</p><div class="product-grid" id="shop-grid">{products.map((product, index) => <div data-product-tags={product.tags.join(',')} data-search={`${product.name} ${product.short} ${product.tags.join(' ')}`.toLowerCase()} data-price={product.price} data-name={product.name} data-order={index}><ProductCard product={product}/></div>)}</div><div id="search-empty" class="search-empty" hidden><h2>Not in this little universe. Yet.</h2><p>Try “Bengaluru”, “desk”, or let the whole gang back in.</p><button class="button" data-reset-search>Show all objects <Icon/></button></div></section>
<section class="shop-outro wrap"><p>Don’t see your personality here?</p><h2>We’re just <span class="serif">getting started.</span></h2><p>More local stories. More tiny existential crises. Future collections will have plenty to say.</p><a class="text-link" href="/philosophy">What goes into a Gubbi object <Icon/></a></section>
</Layout>
