---
import Layout from '../../layouts/Layout.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import Flower from '../../components/Flower.astro';
import '../../styles/character-sections.css';
import { products, money, collection, gallerySrc, type Product } from '../../data/products';
import { site } from '../../data/site';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
interface Props { product: Product; }
const { product } = Astro.props;
const personalities: Record<string, { quote: string; scene: string; talent: string; spot: string; gift: string }> = {
 'traffic-kumar': { quote: '“Five minutes, boss.”', scene: 'The signal changes. Nobody moves. Somewhere, a meeting starts without you. Kumar gets it. Park him by your screen: at least one of you has reached the destination.', talent: 'Being almost there. Forever.', spot: 'Next to your work-from-cab coffee.', gift: 'The friend who left ten minutes ago.' },
 'bartha-idini': { quote: '“Bartha idini. Two minutes.”', scene: 'You said you were leaving. You are, in spirit. Spin the disc, read the segment, and send the one honest ETA of your life. If it lands on rain, the plan was never happening anyway.', talent: 'Turning “on my way” into a number.', spot: 'Between your keys and your phone.', gift: 'The friend who is always “almost there”.' },
 'silk-board-forever': { quote: '“Same signal. New day.”', scene: 'You know this junction better than your own neighbourhood. The cars, the waiting, the ambitious ETA. Here, the whole situation fits in your little corner of the world, and nobody is honking.', talent: 'Making absolutely no progress.', spot: 'Somewhere you can finally stay put.', gift: 'Your partner in the daily vibe.' },
 'token-maxxer': { quote: '“One more prompt, then bed.”', scene: 'The context window is full. So is the incident channel. What began as a quick fix has become a relationship with a chat tab. Spin the wheel, obey the pointer, and let the model take the blame this time.', talent: 'Finding one more thing to regenerate.', spot: 'Within reach of the terminal you keep apologising to.', gift: 'The person whose API bill needs an intervention.' },
 'i-got-it-bruh': { quote: '“Works on my machine.”', scene: 'One has questions. The other has answers, delivered with suspicious confidence. Flip the sign to whichever verdict the pull request deserves and put them beside your keyboard. Every pairing session deserves a tiny audience.', talent: 'Being confidently almost right.', spot: 'Beside your very human keyboard.', gift: 'The person reviewing your pull requests.' },
 'yaavdu-dice': { quote: '“Yaavdu? Roll and see.”', scene: 'Six logos. One question. You roll it on the walnut tray before opening the chat, and whichever face lands up gets today’s prompt. It is not a strategy. It is, however, faster than the strategy meeting.', talent: 'Ending the model debate in one throw.', spot: 'In its tray, right by the mouse.', gift: 'The friend with four subscriptions and no opinion.' },
};
const personality = personalities[product.slug];
const inr = money;
const jsonld = [
 { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url }, { '@type': 'ListItem', position: 2, name: 'Shop', item: `${site.url}/shop` }, { '@type': 'ListItem', position: 3, name: product.name, item: `${site.url}/shop/${product.slug}` }] },
 { '@type': 'Product', '@id': `${site.url}/shop/${product.slug}#product`, name: product.name, description: product.story, sku: `GUBBI-01-${product.number}`, image: [`${site.url}/products/${product.slug}/og.jpg`, `${site.url}${gallerySrc(product.slug, 1, 1200)}`], brand: { '@type': 'Brand', name: site.name }, material: 'Ivory wood, natural lac', color: product.colour, category: 'Home Decor > Decorative Objects', audience: { '@type': 'PeopleAudience', suggestedMinAge: 14 }, countryOfOrigin: 'IN', offers: { '@type': 'Offer', url: `${site.url}/shop/${product.slug}`, priceCurrency: 'INR', price: product.price, availability: 'https://schema.org/InStock', itemCondition: 'https://schema.org/NewCondition', seller: { '@id': `${site.url}/#org` }, shippingDetails: { '@type': 'OfferShippingDetails', shippingRate: { '@type': 'MonetaryAmount', value: site.shippingFlat, currency: 'INR' }, shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'IN' }, deliveryTime: { '@type': 'ShippingDeliveryTime', handlingTime: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 3, unitCode: 'DAY' }, transitTime: { '@type': 'QuantitativeValue', minValue: 4, maxValue: 7, unitCode: 'DAY' } } }, hasMerchantReturnPolicy: { '@type': 'MerchantReturnPolicy', applicableCountry: 'IN', returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow', merchantReturnDays: site.returnDays, returnMethod: 'https://schema.org/ReturnByMail', returnFees: 'https://schema.org/FreeReturn' } } },
];
const related = [...products.filter(item => item.slug !== product.slug && item.tags.some(tag => product.tags.includes(tag))), ...products.filter(item => item.slug !== product.slug && !item.tags.some(tag => product.tags.includes(tag)))].slice(0, 3);
---
<Layout title={`${product.name} — wooden desk collectible, ${money(product.price)} — The Gubbi`} description={`${product.short} ${product.story} Hand-turned in Channapatna, about ${product.height} cm. Ships across India.`} type="product" image={`/products/${product.slug}/og.jpg`} jsonld={jsonld}>
<nav class="breadcrumbs wrap" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/shop">Shop</a><span>/</span><span aria-current="page">{product.name}</span></nav>
<section class="pdp wrap"><div class="pdp-media"><div class="gallery-main" data-gallery><ProductImage product={product} view={1} sizes="(max-width: 760px) 100vw, 52vw" eager/><button class="gallery-zoom icon-button" data-zoom aria-label="Enlarge product image"><Icon name="plus"/></button></div><div class="gallery-tabs" aria-label="Product image views">{product.views.map((view, index) => <button class:list={['gallery-tab', index === 0 && 'is-active']} data-view={index + 1} aria-pressed={index === 0} aria-label={`View ${index + 1}: ${view}`}><ProductImage product={product} view={index + 1} alt="" sizes="90px"/></button>)}</div><p class="gallery-note">About {product.height} cm tall. Hand-turned, so every piece has its own grain.</p></div>
<div class="pdp-info"><div class="pdp-kicker"><span>{product.tags[0]}</span></div><h1>{product.name}</h1><p class="pdp-short">{product.short}</p><div class="pdp-price"><strong>{money(product.price)}</strong><span>Incl. GST · In stock</span></div><p class="pdp-story">{product.story}</p><div class="colour-row"><span class="colour-dot" style={`background:${product.swatch}`}></span><span>{product.colour}</span><span>{collection.name}</span></div><div class="buy-row"><div class="quantity-control"><button class="icon-button" data-quantity-step="-1" aria-label="Decrease quantity"><Icon name="minus"/></button><input id="product-quantity" type="number" min="1" max="10" value="1" aria-label="Quantity"/><button class="icon-button" data-quantity-step="1" aria-label="Increase quantity"><Icon name="plus"/></button></div><button class="button" data-add={product.slug} data-use-quantity>Add to bag <Icon name="bag"/></button></div><p class="purchase-note">Ships in {site.dispatchDays}. Real days, not auto-driver days. Free shipping over {inr(site.freeShippingOver)}. {site.returnDays}-day returns.</p><div class="pdp-details"><details open><summary>Details <Icon name="plus"/></summary><p>About {product.height} cm tall. {collection.material}. {collection.origin}. Decorative object for adults, not a toy; not for children under 14. Comes in a kraft box with the story sleeve and a made-by card.</p></details><details><summary>Care <Icon name="plus"/></summary><p>Wipe with a dry, soft cloth. Keep out of direct sun and away from water; lac colour is natural and will fade if it lives on a windowsill. No polish needed, ever.</p></details><details><summary>Shipping &amp; returns <Icon name="plus"/></summary><p>Dispatched from Bengaluru in {site.dispatchDays}, delivered across India in {site.deliveryDays}. Shipping {inr(site.shippingFlat)}, free over {inr(site.freeShippingOver)}. Damaged in transit? We replace it. Changed your mind? Return an unused piece in its box within {site.returnDays} days. <a href="/shipping-and-returns">Full policy</a>.</p></details></div></div></section>
<section class="gubbi-personality" aria-labelledby="personality-title">
 <div class="wrap gubbi-personality-layout">
  <div class="gubbi-personality-copy"><h2 id="personality-title">{personality.quote}</h2><p class="gubbi-personality-mood">{product.mood}.</p><p>{personality.scene}</p><dl><div><dt>Special talent</dt><dd>{personality.talent}</dd></div><div><dt>Feels at home</dt><dd>{personality.spot}</dd></div><div><dt>Know someone?</dt><dd>{personality.gift}</dd></div></dl></div>
  <figure class="gubbi-personality-print"><div class="gubbi-personality-close"><ProductImage product={product} view={product.scene} sizes="280px"/></div><figcaption><span>{product.name}<small>Big personality. Little desk mate.</small></span></figcaption><span class="gubbi-personality-stamp" aria-hidden="true"><Flower/><span>Local<br/>character.</span></span><p class="gubbi-personality-image-note">Hand-turned · no two alike · about {product.height} cm</p></figure>
 </div>
 <div class="wrap gubbi-personality-signoff"><span>A little piece of your everyday. A little less ordinary.</span><a class="text-link" href="/philosophy">And a craft story worth knowing <Icon/></a></div>
</section>
<section class="related wrap"><header class="section-head"><div><h2>They’d get <span class="serif">along.</span></h2><p>Good company for your new desk mate.</p></div><a href="/shop" class="text-link">Everyone <Icon/></a></header><div class="product-grid">{related.map(item => <ProductCard product={item}/>)}</div></section>
<dialog class="image-dialog" id="image-dialog" aria-label={`${product.name}, enlarged`}><button class="icon-button" data-close-zoom aria-label="Close enlarged image"><Icon name="close"/></button><ProductImage product={product} view={1} sizes="(max-width: 900px) 92vw, 850px"/><p data-zoom-caption>{product.name} · {product.views[0]} · about {product.height} cm</p></dialog>
</Layout>
