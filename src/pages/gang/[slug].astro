---
import Layout from '../../layouts/Layout.astro';
import ProductCrop from '../../components/ProductCrop.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import Flower from '../../components/Flower.astro';
import '../../styles/character-sections.css';
import { products, money, type Product } from '../../data/products';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
interface Props { product: Product; }
const { product } = Astro.props;
const personalities: Record<string, { quote: string; scene: string; talent: string; spot: string; gift: string }> = {
 'traffic-kumar': { quote: '“Five minutes, boss.”', scene: 'The signal changes. Nobody moves. Somewhere, a meeting starts without you. Kumar gets it. Park him by your screen: at least one of you has reached the destination.', talent: 'Being almost there. Forever.', spot: 'Next to your work-from-cab coffee.', gift: 'The friend who left ten minutes ago.' },
 'doomscroll-buddy': { quote: '“Okay, last reel.”', scene: 'One more video becomes twelve. Tomorrow’s alarm is suddenly very close. Buddy has no advice. Just the unmistakable expression of someone who has also seen that reel.', talent: 'Turning five minutes into an hour.', spot: 'Beside the phone you put face down.', gift: 'The bestie sending reels at 2am.' },
 'silk-board-forever-loop': { quote: '“Same signal. New day.”', scene: 'You know this junction better than your own neighbourhood. The cars, the waiting, the ambitious ETA. Here, the whole situation fits in your little corner of the world.', talent: 'Making absolutely no progress.', spot: 'Somewhere you can finally stay put.', gift: 'Your partner in the daily commute.' },
 'workflow-spinner-2am': { quote: '“One tiny fix, then bed.”', scene: 'The room is quiet. The incident channel is not. What began as a quick fix has become a relationship. A little company for the nights that accidentally become mornings.', talent: 'Finding one more thing to debug.', spot: 'Within blaming distance of your laptop.', gift: 'The keeper of the production password.' },
 'copilot-confusion': { quote: '“It worked in the demo.”', scene: 'One has questions. The other has answers, delivered with suspicious confidence. Put them beside your keyboard. Every pair programming session deserves a tiny audience.', talent: 'Being confidently almost right.', spot: 'Beside your very human keyboard.', gift: 'The person reviewing your pull requests.' },
 'namma-metro-sprint': { quote: '“Wait wait wait!”', scene: 'You hear the chime. You make eye contact with the doors. You become an athlete for approximately four seconds. A little tribute to the sprint nobody trained for.', talent: 'Finding a final burst of optimism.', spot: 'By the keys you’re always looking for.', gift: 'The friend with impeccable almost-timing.' },
};
const personality = personalities[product.slug];
const related = [...products.filter(item => item.slug !== product.slug && item.tags.some(tag => product.tags.includes(tag))), ...products.filter(item => item.slug !== product.slug && !item.tags.some(tag => product.tags.includes(tag)))].slice(0, 3);
---
<Layout title={`${product.name} — The Gubbi`} description={product.story}>
<nav class="breadcrumbs wrap" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/shop">Objects</a><span>/</span><span aria-current="page">{product.name}</span></nav>
<section class="pdp wrap"><div class="pdp-media"><div class="gallery-main" data-gallery><ProductCrop position={product.position} alt={`${product.name} — full object concept`} eager/><span class="gallery-label" data-gallery-label>THE WHOLE PERSONALITY</span><button class="gallery-zoom icon-button" data-zoom aria-label="Enlarge product image"><Icon name="plus"/></button></div><div class="gallery-tabs" aria-label="Product image views"><button class="gallery-tab is-active" data-view="whole" aria-pressed="true"><ProductCrop position={product.position} alt=""/><span>The object</span></button><button class="gallery-tab" data-view="detail" aria-pressed="false"><ProductCrop position={product.position} alt="" detail/><span>A closer look</span></button><p>Concept imagery.<br/>The proper photoshoot is on its way.</p></div></div>
<div class="pdp-info"><div class="pdp-kicker"><span>{product.tags[0]}</span><span>G / {product.number}</span></div><h1>{product.name}</h1><p class="pdp-short">{product.short}</p><div class="pdp-price"><strong>{money(product.price)}</strong><span>Illustrative price</span></div><p class="pdp-story">{product.story}</p><div class="colour-row"><span class:list={['colour-dot', `colour-${product.number}`]}></span><span>{product.colour}</span><span>Collection 01</span></div><div class="buy-row"><div class="quantity-control"><button class="icon-button" data-quantity-step="-1" aria-label="Decrease quantity"><Icon name="minus"/></button><input id="product-quantity" type="number" min="1" max="10" value="1" aria-label="Quantity"/><button class="icon-button" data-quantity-step="1" aria-label="Increase quantity"><Icon name="plus"/></button></div><button class="button" data-add={product.slug} data-use-quantity>Add to bag <Icon name="bag"/></button></div><p class="purchase-note">Collection preview. No payment or order is taken.</p><div class="pdp-details"><details open><summary>The small print <Icon name="plus"/></summary><p>Designed as an adult collectible. This is an early concept, not a final manufactured product. Dimensions, materials, maker details and final pricing will be confirmed before launch.</p></details><details><summary>What’s in the box? <Icon name="plus"/></summary><p>The plan: your object, its story, and details of the people and craft behind it. Final packaging and contents will be shown with the approved product.</p></details><details><summary>Shipping & care <Icon name="plus"/></summary><p>Shipping timelines, delivery regions, returns and care instructions will be published when production details are confirmed. The preview bag does not reserve stock.</p></details></div></div></section>
<section class="gang-personality" aria-labelledby="personality-title">
 <div class="wrap gang-personality-layout">
  <div class="gang-personality-copy"><h2 id="personality-title">{personality.quote}</h2><p class="gang-personality-mood">{product.mood}.</p><p>{personality.scene}</p><dl><div><dt>Special talent</dt><dd>{personality.talent}</dd></div><div><dt>Feels at home</dt><dd>{personality.spot}</dd></div><div><dt>Know someone?</dt><dd>{personality.gift}</dd></div></dl></div>
  <figure class="gang-personality-print"><div class="gang-personality-close"><ProductCrop position={product.position} alt={`${product.name}: a close-up of the character concept`} detail/></div><figcaption><span>{product.name}<small>Big personality. Little desk mate.</small></span><span>G / {product.number}</span></figcaption><span class="gang-personality-stamp" aria-hidden="true"><Flower/><span>Local<br/>character.</span></span><p class="gang-personality-image-note">Concept detail · final photography to follow</p></figure>
 </div>
 <div class="wrap gang-personality-signoff"><span>A little piece of your everyday. A little less ordinary.</span><a class="text-link" href="/philosophy">And a craft story worth knowing <Icon/></a></div>
</section>
<section class="related wrap"><header class="section-head"><div><h2>They’d get <span class="serif">along.</span></h2><p>Good company for your new desk mate.</p></div><a href="/shop" class="text-link">All objects <Icon/></a></header><div class="product-grid">{related.map(item => <ProductCard product={item}/>)}</div></section>
<dialog class="image-dialog" id="image-dialog" aria-label={`${product.name} enlarged concept image`}><button class="icon-button" data-close-zoom aria-label="Close enlarged image"><Icon name="close"/></button><ProductCrop position={product.position} alt={`${product.name} — enlarged concept image`}/><p>Concept image · final photography in progress</p></dialog>
</Layout>
