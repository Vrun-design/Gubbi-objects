---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import '../styles/art-club.css';
interface Props { title?: string; description?: string; }
const { title = 'The Gubbi — Small objects. Big Bengaluru energy.', description = 'A little local. A lot of character. Discover collectible object concepts inspired by Bengaluru life and Channapatna craft.' } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="robots" content="noindex, nofollow"/><meta name="theme-color" content="#2449d8"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><link rel="icon" href="/brand/gubbi-app-icon.svg"/><link rel="preload" href="/fonts/display.ttf" as="font" type="font/ttf" crossorigin/><title>{title}</title></head>
<body><a class="skip" href="#main">Skip to content</a><Header/><main id="main"><slot/></main><Footer/>
<dialog class="bag" id="bag" aria-labelledby="bag-title"><div class="bag__head"><span>The good stuff</span><button class="icon-button" data-close-bag aria-label="Close bag"><Icon name="close"/></button></div><h2 id="bag-title">Your little haul.</h2><p class="small muted">A preview bag. Real good taste.</p><div id="bag-items" class="bag__items"></div><div class="bag__empty" id="bag-empty"><img src="/brand/gubbi-flower.svg" alt="" width="90" height="90"/><h3>A little empty in here.</h3><p>Some excellent company is one click away.</p><a class="button" href="/shop">Meet the objects <Icon/></a></div><div class="bag__bottom" id="bag-summary" hidden><div class="subtotal"><span>Subtotal</span><strong data-bag-total></strong></div><p class="small muted">Illustrative prices. Shipping and taxes aren’t calculated. No payment will be taken.</p><a class="button button--wide" href="/checkout">Preview checkout <Icon/></a><button class="text-button" data-close-bag>Keep looking</button></div></dialog>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>import '../scripts/storefront';</script>
</body></html>
